# Build artifacts
/portside
/bin/
*.exe

# Go
/vendor/

# Env
.env

# >>> satelle (managed) >>>
# .satelle/ is this repo's process substrate (workflows, skills, principles,
# constitution, satelle.toml, tasks, documents) and is tracked in git; only the
# machine-local state below is ignored. The re-include overrides a machine-wide
# core.excludesFile that ignores .satelle/. satelle adds only entries this file
# does not already settle; any rule written here or elsewhere is kept.
# Runtime state lives under ~/.satelle/<repo-key>/, outside the repo.
.satelle/satelle.local.toml
.satelle/workflows/agents.local.toml
.satelle/satelle
sty_*_body.md
sty_*_ac.md
!.satelle/
.satelle/**/.env
.satelle/logs
.satelle/hooks
.satelle/deployed.version
.satelle/*.local.toml
.satelle/tasks/*/exe_*.md
# <<< satelle (managed) <<<
.grok/

# Agent / developer tooling — personal setup, never committed.
.claude/
CLAUDE.md
AGENTS.md

# Operator (2026-11-04): .satelle/ substrate is tracked in git. Task run
# records/outputs, config bundles, backups and local/db state stay
# machine-local; files a task needs (scripts, reports) are tracked.
.satelle/tasks/*/output-exe_*.md
.satelle/tasks/*/route.md
.satelle/tasks/*/config-*.md
.satelle/tasks/*/exe_*.md
.satelle/backups/
.satelle/**/*.bak
.satelle/**/*.bak-*
.satelle/**/*.local.*
.satelle/**/*.db*
